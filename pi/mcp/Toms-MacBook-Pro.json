{
  "mcpServers": {
    "hey": {
      "command": "/etc/profiles/per-user/tgeorge/bin/hey",
      "args": [
        "mcp",
        "--read-only",
        "--domains",
        "threads,search,boxes"
      ],
      "env": {
        "HEY_NONINTERACTIVE": "1"
      }
    },
    "hey-triage": {
      "command": "/etc/profiles/per-user/tgeorge/bin/hey",
      "args": [
        "mcp",
        "--domains",
        "contacts"
      ],
      "env": {
        "HEY_NONINTERACTIVE": "1"
      }
    },
    "todoist": {
      "url": "https://ai.todoist.net/mcp"
    },
    "fantastical": {
      "command": "/Applications/Fantastical.app/Contents/Helpers/FantasticalMCP.app/Contents/MacOS/FantasticalMCP"
    },
    "ynab": {
      "command": "/etc/profiles/per-user/tgeorge/bin/npx",
      "args": ["-y", "ynab-mcp-server@0.7.1"],
      "env": {
        "YNAB_API_TOKEN": "!security find-generic-password -s ynab-api-token -w"
      }
    }
  }
}
