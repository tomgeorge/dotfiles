theme = Catppuccin Frappe
font-family = DejaVu Sans Mono
font-size = 14
background-opacity = 0.9
# ponytail: closest macOS gets to wezterm's flat tab bar — bottom tabs are GTK-only
macos-titlebar-style = tabs
gtk-tabs-location = bottom
# absolute path: GUI launches don't inherit the nix PATH
command = /run/current-system/sw/bin/fish -l

# leader = ctrl+a (tmux-style), matching wezterm
# keybind = ctrl+a>ctrl+a=text:\x01
